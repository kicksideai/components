{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "queued",
        "sent",
        "failed"
      ]
    },
    "since": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "cursor": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9a-fA-F-]{36}$"
    }
  },
  "required": [
    "limit"
  ]
}
