{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "preview_id"
  ],
  "properties": {
    "command_id": {"type": "string", "format": "uuid"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "title",
          "description",
          "html",
          "text",
          "schema",
          "samples",
          "expected_revision"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "message",
              "base",
              "part"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "object",
            "required": [
              "type",
              "properties"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "properties": {
                "type": "object"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "samples": {
            "type": "object"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "preview_id": {
      "type": "string",
      "description": "Short-lived proof of a clean preview of these exact changes."
    },
    "note": {
      "type": "string"
    }
  }
}
