{
  "type": "object",
  "required": [
    "kind",
    "name",
    "seq",
    "version",
    "action",
    "author",
    "created_at"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "base",
        "part",
        "asset"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "original",
        "customized",
        "created"
      ]
    },
    "action": {
      "enum": [
        "created",
        "edited",
        "base_changed",
        "reset",
        "restored",
        "archived",
        "deleted"
      ]
    },
    "restored_from": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "created_at": {
      "type": "integer"
    },
    "content": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "title",
        "description",
        "html",
        "text",
        "schema",
        "samples"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "message",
            "base",
            "part",
            "asset"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "html": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "schema": {
          "type": "object",
          "required": [
            "type",
            "properties"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "properties": {
              "type": "object"
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "samples": {
          "type": "object"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        },
        "asset": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "original",
                "upload"
              ]
            },
            "upload_id": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "content_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "type": "string"
    }
  }
}
