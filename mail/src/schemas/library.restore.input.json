{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "seq",
    "expected_revision"
  ],
  "anyOf": [
    {
      "properties": {
        "kind": {
          "const": "asset"
        }
      }
    },
    {
      "required": [
        "preview_id"
      ]
    }
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "base",
        "part",
        "asset"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "note": {
      "type": "string"
    },
    "preview_id": {
      "type": "string",
      "description": "Short-lived proof of a clean preview of these exact changes."
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
