{
  "type": "object",
  "required": [
    "kind",
    "name",
    "revision"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "base",
        "part",
        "asset"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
