{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "queued",
              "sent",
              "failed"
            ]
          },
          "sender": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "next_attempt_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sent_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "finished_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reply_to": {
            "type": "string",
            "minLength": 1
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "upload_id": {
                  "type": "string",
                  "minLength": 1
                },
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "attachment",
                    "inline"
                  ]
                },
                "content_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "upload_id"
              ]
            }
          },
          "driver_id": {
            "type": "string",
            "minLength": 1,
            "description": "Active driver used for the last delivery attempt. Available only to delivery log administrators."
          },
          "provider_message_id": {
            "type": "string",
            "minLength": 1,
            "description": "Message ID returned by the provider on acceptance. Available only to delivery log administrators."
          },
          "last_error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "code",
              "message"
            ]
          }
        },
        "required": [
          "message_id",
          "status",
          "sender",
          "created_at",
          "attempts",
          "subject",
          "to",
          "attachments"
        ]
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9a-fA-F-]{36}$"
    }
  },
  "required": [
    "items",
    "has_more"
  ]
}
