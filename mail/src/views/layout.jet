<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{ message.subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;color:#1f2328;">
  {{ include "/part/preheader" }}
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f4f5f7" style="background-color:#f4f5f7;">
    <tr><td align="center" style="padding:24px 12px 32px;">
      <!--[if mso]><table role="presentation" width="600" align="center" cellspacing="0" cellpadding="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;table-layout:fixed;font-family:Arial,Helvetica,sans-serif;">
        <tr><td align="left" style="padding:0 32px 16px;padding-left:5.55%;padding-right:5.55%;">{{ include "/part/header" }}</td></tr>
        <tr><td align="left" bgcolor="#ffffff" style="padding:32px;padding-left:5.55%;padding-right:5.55%;background-color:#ffffff;border:1px solid #e3e6ea;border-radius:12px;color:#1f2328;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;overflow-wrap:anywhere;">
          {{ block body() }}{{ if isset(_mail_html) }}{{ raw(_mail_html) }}{{ else if isset(_mail_text) }}<pre style="margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;">{{ _mail_text }}</pre>{{ end }}{{ end }}
        </td></tr>
        <tr><td align="left" style="padding:20px 32px 0;padding-left:5.55%;padding-right:5.55%;">{{ include "/part/footer" }}</td></tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td></tr>
  </table>
</body>
</html>
