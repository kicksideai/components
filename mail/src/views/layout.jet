{* SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0 *}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ message.subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f4f7;color:#202938;">
  {{ include "/part/preheader" }}
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f2f4f7;">
    <tr><td align="center" style="padding:20px 0;">
      <!--[if mso]><table role="presentation" width="600" align="center" cellspacing="0" cellpadding="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;">
        <tr>
          <td align="center" style="padding:24px 24px 20px;border-top:4px solid #ee4f36;border-bottom:1px solid #e3e7ed;">
            {{ include "/part/header" }}
          </td>
        </tr>
        <tr>
          <td style="padding:28px 24px 32px;color:#202938;font-size:16px;line-height:1.55;overflow-wrap:anywhere;">
            {{ block body() }}{{ if isset(_mail_html) }}{{ raw(_mail_html) }}{{ else if isset(_mail_text) }}<pre style="margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;">{{ _mail_text }}</pre>{{ end }}{{ end }}
          </td>
        </tr>
        <tr>
          <td style="padding:17px 24px;border-top:1px solid #e3e7ed;background-color:#f8f9fb;color:#5b6575;font-size:13px;line-height:20px;">{{ include "/part/footer" }}</td>
        </tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td></tr>
  </table>
</body>
</html>
