{* SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0 *}<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ message.subject }}</title></head>
<body style="margin:0;padding:0;color:#202938;font-family:Arial,Helvetica,sans-serif;">
  {{ include "/part/preheader" }}
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr><td align="center">
      <!--[if mso]><table role="presentation" width="600" align="center" cellspacing="0" cellpadding="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;">
        <tr><td style="padding:24px;font-size:16px;line-height:1.55;overflow-wrap:anywhere;">{{ block body() }}{{ end }}</td></tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td></tr>
  </table>
</body>
</html>
