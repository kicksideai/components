{{ extends "/base/standard" }}{* SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0 *}
{{ block body() }}
  {{ if isset(heading) }}<h1 style="margin:0 0 16px;color:#1f2328;font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:1.25;">{{ heading }}</h1>{{ end }}
  {{ if isset(vars.message) }}<p style="margin:0 0 14px;">{{ vars.message }}</p>{{ end }}
  {{ if isset(paragraphs) }}{{ range _, paragraph := paragraphs }}<p style="margin:0 0 14px;">{{ paragraph }}</p>{{ end }}{{ end }}
  {{ if isset(action_url, action_label) && action_label != "" && (hasPrefix(action_url, "https://") || hasPrefix(action_url, "http://")) }}
    {{ include "/part/button" vars }}
  {{ end }}
  {{ if isset(inline_content_id) }}
    {{ alt := "Notice image" }}
    {{ if isset(image_alt) && image_alt != "" }}{{ alt = image_alt }}{{ end }}
    {{ include "/part/image" map("src", "cid:" + inline_content_id, "alt", alt, "width", 534) }}
  {{ end }}
  {{ if isset(details) && len(details) > 0 }}
    {{ include "/part/details" vars }}
  {{ end }}
{{ end }}
