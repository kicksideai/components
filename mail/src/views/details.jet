{* SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0 *}<table width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;table-layout:fixed;margin-top:20px;border-collapse:collapse;color:#1f2328;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;">
  {{ range _, row := .details }}
  <tr>
    <th scope="row" width="34%" align="left" valign="top" style="box-sizing:border-box;padding:10px 8px 10px 0;border-top:1px solid #e3e6ea;color:#59636e;font-weight:normal;overflow-wrap:anywhere;">{{ row.key }}</th>
    <td valign="top" style="padding:10px 0;border-top:1px solid #e3e6ea;overflow-wrap:anywhere;">{{ row.value }}</td>
  </tr>
  {{ end }}
</table>
