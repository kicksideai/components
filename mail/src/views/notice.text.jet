{{ extends "/base/standard" }}{* SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0 *}
{{ block body() -}}
{{ if isset(preheader) && preheader != "" && preheader != message.subject }}{{ include "/part/preheader" }}

{{ end -}}
{{ if isset(heading) }}{{ heading }}

{{ end -}}
{{ if isset(vars.message) }}{{ vars.message }}{{ end -}}
{{ if isset(paragraphs) }}{{ range _, paragraph := paragraphs }}

{{ paragraph }}{{ end }}{{ end -}}
{{ if isset(action_url, action_label) && action_label != "" && (hasPrefix(action_url, "https://") || hasPrefix(action_url, "http://")) }}

{{ include "/part/button" vars }}{{ end -}}
{{ if isset(inline_content_id) -}}
{{ alt := "Notice image" -}}
{{ if isset(image_alt) && image_alt != "" }}{{ alt = image_alt }}{{ end }}

{{ include "/part/image" map("alt", alt) }}{{ end -}}
{{ if isset(details) && len(details) > 0 }}

{{ include "/part/details" vars }}{{ end -}}
{{ end }}
