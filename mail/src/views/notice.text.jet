{* SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0 *}{{ extends "layout.text" }}
{{ block body() -}}
{{ if isset(heading) }}{{ raw(heading) }}

{{ end -}}
{{ if isset(message) }}{{ raw(message) }}{{ end -}}
{{ if isset(paragraphs) }}{{ range _, paragraph := paragraphs }}

{{ raw(paragraph) }}{{ end }}{{ end -}}
{{ if isset(action_url, action_label) && action_label != "" && (hasPrefix(action_url, "https://") || hasPrefix(action_url, "http://")) }}

{{ raw(action_label) }}
{{ raw(action_url) }}{{ end -}}
{{ if isset(inline_content_id) }}

{{ if isset(image_alt) }}{{ raw(image_alt) }}{{ else }}Notice image{{ end }}{{ end -}}
{{ if isset(details) && len(details) > 0 }}
{{ range _, row := details }}
{{ raw(row.key) }}: {{ raw(row.value) }}{{ end }}{{ end -}}
{{ end }}
