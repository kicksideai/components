{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docscout extractor configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "default": "text",
            "enum": [
              "text",
              "number",
              "boolean",
              "date",
              "enum",
              "list",
              "object"
            ]
          },
          "description": {
            "type": "string",
            "default": "",
            "maxLength": 4000
          },
          "enum_values": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "item_type": {
            "type": "string",
            "default": "text",
            "enum": [
              "text",
              "number",
              "boolean",
              "date",
              "object"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "search_hints": {
            "type": "string",
            "default": "",
            "maxLength": 4000
          },
          "validation_hints": {
            "type": "string",
            "default": "",
            "maxLength": 4000
          },
          "expected_format": {
            "type": "string",
            "default": "",
            "maxLength": 400
          },
          "strategy": {
            "type": "string",
            "default": "standard",
            "enum": [
              "standard",
              "deep"
            ]
          },
          "search_within": {
            "type": "string",
            "default": "document",
            "enum": [
              "document",
              "sections"
            ]
          },
          "group": {
            "type": "string",
            "default": "",
            "maxLength": 80
          },
          "evidence_required": {
            "type": "boolean",
            "default": true
          },
          "chunks": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "name",
          "type",
          "description",
          "enum_values",
          "item_type",
          "required",
          "search_hints",
          "validation_hints",
          "expected_format",
          "strategy",
          "search_within",
          "group",
          "evidence_required",
          "chunks"
        ],
        "default": {
          "name": "",
          "type": "text",
          "description": "",
          "enum_values": [],
          "item_type": "text",
          "required": false,
          "search_hints": "",
          "validation_hints": "",
          "expected_format": "",
          "strategy": "standard",
          "search_within": "document",
          "group": "",
          "evidence_required": true,
          "chunks": 5
        }
      },
      "maxItems": 100
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "model": {
              "type": "string",
              "default": "class:fast",
              "minLength": 1,
              "maxLength": 200
            },
            "outline": {
              "type": "string",
              "default": "find_or_build",
              "enum": [
                "find_or_build",
                "build"
              ]
            },
            "section_summaries": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "enabled",
            "model",
            "outline",
            "section_summaries"
          ],
          "default": {
            "enabled": true,
            "model": "class:fast",
            "outline": "find_or_build",
            "section_summaries": false
          }
        },
        "prefetch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "queries": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "default": ""
                  },
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "default": ""
                  },
                  "chunks": {
                    "type": "integer",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "name",
                  "query",
                  "chunks"
                ],
                "default": {
                  "name": "",
                  "query": "",
                  "chunks": 5
                }
              },
              "maxItems": 100
            }
          },
          "required": [
            "enabled",
            "queries"
          ],
          "default": {
            "enabled": true,
            "queries": []
          }
        },
        "scout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "mode": {
              "type": "string",
              "default": "loop",
              "enum": [
                "loop",
                "agent"
              ]
            },
            "model": {
              "type": "string",
              "default": "class:fast",
              "minLength": 1,
              "maxLength": 200
            },
            "max_rounds": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 30
            },
            "target_confidence": {
              "type": "number",
              "default": 0.7,
              "minimum": 0,
              "maximum": 1
            },
            "max_extra_queries": {
              "type": "integer",
              "default": 3,
              "minimum": 0,
              "maximum": 20
            },
            "max_tokens": {
              "type": "integer",
              "default": 4096,
              "minimum": 256,
              "maximum": 64000
            },
            "drop_noise": {
              "type": "boolean",
              "default": true
            },
            "share_notes": {
              "type": "boolean",
              "default": true
            },
            "tools": {
              "type": "array",
              "default": [
                "kickside.docscout.tools:keyword_search",
                "kickside.docscout.tools:semantic_search",
                "kickside.docscout.tools:read_section",
                "kickside.docscout.tools:read_outline"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "kickside.docscout.tools:keyword_search",
                  "kickside.docscout.tools:semantic_search",
                  "kickside.docscout.tools:read_section",
                  "kickside.docscout.tools:read_outline"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "enabled",
            "mode",
            "model",
            "max_rounds",
            "target_confidence",
            "max_extra_queries",
            "max_tokens",
            "drop_noise",
            "share_notes",
            "tools"
          ],
          "default": {
            "enabled": true,
            "mode": "loop",
            "model": "class:fast",
            "max_rounds": 0,
            "target_confidence": 0.7,
            "max_extra_queries": 3,
            "max_tokens": 4096,
            "drop_noise": true,
            "share_notes": true,
            "tools": [
              "kickside.docscout.tools:keyword_search",
              "kickside.docscout.tools:semantic_search",
              "kickside.docscout.tools:read_section",
              "kickside.docscout.tools:read_outline"
            ]
          }
        },
        "deep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "model": {
              "type": "string",
              "default": "class:fast",
              "minLength": 1,
              "maxLength": 200
            },
            "query_model": {
              "type": "string",
              "default": "class:fast",
              "minLength": 1,
              "maxLength": 200
            },
            "read": {
              "type": "string",
              "default": "chunks",
              "enum": [
                "chunks",
                "sections"
              ]
            },
            "parallel_fields": {
              "type": "integer",
              "default": 4,
              "minimum": 1,
              "maximum": 20
            },
            "max_queries": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 100
            },
            "chunks_per_query": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 1000
            },
            "chunk_cap": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 10000
            },
            "min_similarity": {
              "type": "number",
              "default": 0.2,
              "minimum": 0,
              "maximum": 1
            },
            "query_temperature": {
              "type": "number",
              "default": 0.2,
              "minimum": 0,
              "maximum": 2
            },
            "analysis_temperature": {
              "type": "number",
              "default": 0.2,
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "enabled",
            "model",
            "query_model",
            "read",
            "parallel_fields",
            "max_queries",
            "chunks_per_query",
            "chunk_cap",
            "min_similarity",
            "query_temperature",
            "analysis_temperature"
          ],
          "default": {
            "enabled": true,
            "model": "class:fast",
            "query_model": "class:fast",
            "read": "chunks",
            "parallel_fields": 4,
            "max_queries": 5,
            "chunks_per_query": 50,
            "chunk_cap": 100,
            "min_similarity": 0.2,
            "query_temperature": 0.2,
            "analysis_temperature": 0.2
          }
        },
        "extract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "default": "class:premium",
              "minLength": 1,
              "maxLength": 200
            },
            "structured_output": {
              "type": "boolean",
              "default": true
            },
            "max_output_tokens": {
              "type": "integer",
              "default": 4096,
              "minimum": 256,
              "maximum": 64000
            },
            "max_fields_per_call": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "model",
            "structured_output",
            "max_output_tokens",
            "max_fields_per_call"
          ],
          "default": {
            "model": "class:premium",
            "structured_output": true,
            "max_output_tokens": 4096,
            "max_fields_per_call": 20
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "model": {
              "type": "string",
              "default": "class:fast",
              "minLength": 1,
              "maxLength": 200
            },
            "check_quotes": {
              "type": "boolean",
              "default": true
            },
            "check_support": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "enabled",
            "model",
            "check_quotes",
            "check_support"
          ],
          "default": {
            "enabled": false,
            "model": "class:fast",
            "check_quotes": true,
            "check_support": true
          }
        }
      },
      "required": [
        "map",
        "prefetch",
        "scout",
        "deep",
        "extract",
        "verify"
      ],
      "default": {
        "map": {
          "enabled": true,
          "model": "class:fast",
          "outline": "find_or_build",
          "section_summaries": false
        },
        "prefetch": {
          "enabled": true,
          "queries": []
        },
        "scout": {
          "enabled": true,
          "mode": "loop",
          "model": "class:fast",
          "max_rounds": 0,
          "target_confidence": 0.7,
          "max_extra_queries": 3,
          "max_tokens": 4096,
          "drop_noise": true,
          "share_notes": true,
          "tools": [
            "kickside.docscout.tools:keyword_search",
            "kickside.docscout.tools:semantic_search",
            "kickside.docscout.tools:read_section",
            "kickside.docscout.tools:read_outline"
          ]
        },
        "deep": {
          "enabled": true,
          "model": "class:fast",
          "query_model": "class:fast",
          "read": "chunks",
          "parallel_fields": 4,
          "max_queries": 5,
          "chunks_per_query": 50,
          "chunk_cap": 100,
          "min_similarity": 0.2,
          "query_temperature": 0.2,
          "analysis_temperature": 0.2
        },
        "extract": {
          "model": "class:premium",
          "structured_output": true,
          "max_output_tokens": 4096,
          "max_fields_per_call": 20
        },
        "verify": {
          "enabled": false,
          "model": "class:fast",
          "check_quotes": true,
          "check_support": true
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunk_size": {
          "type": "integer",
          "default": 1200,
          "minimum": 100,
          "maximum": 16000
        },
        "overlap": {
          "type": "integer",
          "default": 150,
          "minimum": 0,
          "maximum": 4000
        },
        "split_headings": {
          "type": "boolean",
          "default": true
        },
        "keep_tables": {
          "type": "boolean",
          "default": true
        },
        "search_mode": {
          "type": "string",
          "default": "hybrid",
          "enum": [
            "keyword",
            "semantic",
            "hybrid"
          ]
        },
        "embedding_model": {
          "type": "string",
          "default": "class:embed",
          "minLength": 1,
          "maxLength": 200
        },
        "context": {
          "type": "string",
          "default": "headings",
          "enum": [
            "none",
            "headings",
            "generated"
          ]
        },
        "context_model": {
          "type": "string",
          "default": "class:fast",
          "minLength": 1,
          "maxLength": 200
        },
        "highlighter": {
          "type": "boolean",
          "default": false
        },
        "highlighter_model": {
          "type": "string",
          "default": "class:fast",
          "minLength": 1,
          "maxLength": 200
        },
        "section_budget": {
          "type": "integer",
          "default": 6000,
          "minimum": 500,
          "maximum": 64000
        }
      },
      "required": [
        "chunk_size",
        "overlap",
        "split_headings",
        "keep_tables",
        "search_mode",
        "embedding_model",
        "context",
        "context_model",
        "highlighter",
        "highlighter_model",
        "section_budget"
      ],
      "default": {
        "chunk_size": 1200,
        "overlap": 150,
        "split_headings": true,
        "keep_tables": true,
        "search_mode": "hybrid",
        "embedding_model": "class:embed",
        "context": "headings",
        "context_model": "class:fast",
        "highlighter": false,
        "highlighter_model": "class:fast",
        "section_budget": 6000
      }
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 50
    }
  },
  "required": [
    "fields",
    "stages",
    "retrieval",
    "tags"
  ],
  "default": {
    "fields": [],
    "stages": {
      "map": {
        "enabled": true,
        "model": "class:fast",
        "outline": "find_or_build",
        "section_summaries": false
      },
      "prefetch": {
        "enabled": true,
        "queries": []
      },
      "scout": {
        "enabled": true,
        "mode": "loop",
        "model": "class:fast",
        "max_rounds": 0,
        "target_confidence": 0.7,
        "max_extra_queries": 3,
        "max_tokens": 4096,
        "drop_noise": true,
        "share_notes": true,
        "tools": [
          "kickside.docscout.tools:keyword_search",
          "kickside.docscout.tools:semantic_search",
          "kickside.docscout.tools:read_section",
          "kickside.docscout.tools:read_outline"
        ]
      },
      "deep": {
        "enabled": true,
        "model": "class:fast",
        "query_model": "class:fast",
        "read": "chunks",
        "parallel_fields": 4,
        "max_queries": 5,
        "chunks_per_query": 50,
        "chunk_cap": 100,
        "min_similarity": 0.2,
        "query_temperature": 0.2,
        "analysis_temperature": 0.2
      },
      "extract": {
        "model": "class:premium",
        "structured_output": true,
        "max_output_tokens": 4096,
        "max_fields_per_call": 20
      },
      "verify": {
        "enabled": false,
        "model": "class:fast",
        "check_quotes": true,
        "check_support": true
      }
    },
    "retrieval": {
      "chunk_size": 1200,
      "overlap": 150,
      "split_headings": true,
      "keep_tables": true,
      "search_mode": "hybrid",
      "embedding_model": "class:embed",
      "context": "headings",
      "context_model": "class:fast",
      "highlighter": false,
      "highlighter_model": "class:fast",
      "section_budget": 6000
    },
    "tags": []
  }
}
