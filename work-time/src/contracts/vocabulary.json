    "item_summary": {
      "type": "object",
      "properties": {
        "item": {
          "$time_ref": "id"
        },
        "minutes": {
          "type": "integer",
          "minimum": 0
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "original_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "over_estimate": {
          "type": "boolean"
        }
      },
      "required": [
        "item",
        "minutes",
        "entry_count",
        "over_estimate"
      ],
      "additionalProperties": false
    },
    "summaries": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$time_ref": "item_summary"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "sprint": {
          "$time_ref": "id"
        },
        "person": {
          "$time_ref": "id"
        },
        "person_name": {
          "type": "string"
        },
        "week": {
          "$time_ref": "date"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "minutes": {
          "type": "integer",
          "minimum": 0
        },
        "original_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "number"
        }
      },
      "required": [
        "board_id",
        "entry_count",
        "minutes"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$time_ref": "group"
          }
        },
        "cursor": {
          "$time_ref": "cursor"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "limited"
          ]
        },
        "direct_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "subtree_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "original_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "over_estimate": {
          "type": "boolean"
        }
      },
      "required": [
        "coverage"
      ],
      "additionalProperties": false
    }
  },
  "operations": [
    {
      "method": "create",
      "output": "created",
      "title": "Log time on a Work item",
      "tool": "WorkLogTime",
      "entry": "log_time",
      "access": "write",
      "http": "POST",
      "path": "worklogs"
    },
    {
      "method": "edit",
      "output": "changed",
      "title": "Edit a versioned worklog",
      "tool": "WorkEditWorklog",
      "entry": "edit_worklog",
      "access": "write",
      "http": "PATCH",
      "path": "worklogs/{id}"
    },
    {
      "method": "delete",
      "output": "changed",
      "title": "Delete a versioned worklog",
      "tool": "WorkDeleteWorklog",
      "entry": "delete_worklog",
      "access": "write",
      "http": "DELETE",
      "path": "worklogs/{id}"
    },
    {
      "method": "list",
      "output": "listing",
      "title": "List visible Work time entries",
      "tool": "WorkListWorklogs",
      "entry": "list_worklogs",
      "access": "read",
      "http": "GET",
      "path": "worklogs"
    },
    {
      "method": "totals",
      "output": "report",
      "title": "Read Work time totals",
      "sprint_report": true,
      "tool": "WorkTimeTotals",
      "entry": "time_totals",
      "access": "read",
      "http": "POST",
      "path": "totals"
    },
    {
      "method": "summary",
      "output": "summaries",
      "title": "Read direct time and estimates for a batch of items",
      "http": "POST",
      "path": "summary"
    },
    {
      "method": "export",
      "input": "totals",
      "title": "Export a page of visible timesheet rows",
      "sprint_report": true,
      "http": "GET",
      "path": "export.csv"
    },
    {
      "method": "estimate_fields",
      "output": "estimates",
      "title": "Discover the active Time estimate field codes"
    }
  ],
  "fixtures": {
    "create": {
      "valid": [
        {
          "board_id": "board",
          "item": "item",
          "minutes": 15,
          "work_date": "2026-11-21",
          "key": "retry"
        }
      ],
      "invalid": [
        {
          "board_id": "board",
          "item": "item",
          "minutes": 15,
          "work_date": "2026-11-21",
          "key": "retry",
          "person": "another"
        },
        {
          "board_id": "board",
          "item": "item",
          "minutes": 0,
          "work_date": "2026-11-21",
          "key": "retry"
        }
      ]
    },
    "edit": {
      "valid": [
        {
          "board_id": "board",
          "id": "entry",
