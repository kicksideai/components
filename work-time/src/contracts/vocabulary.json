{
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "group_by": {
      "type": "string",
      "enum": [
        "board",
        "person_week",
        "sprint"
      ]
    },
    "create": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "item": {
          "$time_ref": "id"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "work_date": {
          "$time_ref": "date"
        },
        "note": {
          "type": "string",
          "maxLength": 8192
        },
        "key": {
          "$time_ref": "id"
        }
      },
      "required": [
        "board_id",
        "item",
        "minutes",
        "work_date",
        "key"
      ],
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "id": {
          "$time_ref": "id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "work_date": {
          "$time_ref": "date"
        },
        "note": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "required": [
        "board_id",
        "id",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "delete": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "id": {
          "$time_ref": "id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "board_id",
        "id",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "created": {
      "type": "object",
      "properties": {
        "id": {
          "$time_ref": "id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "replayed"
      ],
      "additionalProperties": false
    },
    "changed": {
      "type": "object",
      "properties": {
        "id": {
          "$time_ref": "id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "item": {
          "$time_ref": "id"
        },
        "from": {
          "$time_ref": "date"
        },
        "to": {
          "$time_ref": "date"
        },
        "person": {
          "$time_ref": "id"
        },
        "cursor": {
          "$time_ref": "cursor"
        },
        "limit": {
          "$time_ref": "page"
        }
      },
      "required": [
        "board_id"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "item": {
          "$time_ref": "id"
        },
        "from": {
          "$time_ref": "date"
        },
        "to": {
          "$time_ref": "date"
        },
        "person": {
          "$time_ref": "id"
        },
        "cursor": {
          "$time_ref": "cursor"
        },
        "limit": {
          "$time_ref": "page"
        },
        "sprint": {
          "$time_ref": "id"
        },
        "group_by": {
          "$time_ref": "group_by"
        }
      },
      "required": [
        "board_id"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        },
        "items": {
          "type": "array",
          "items": {
            "$time_ref": "id"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "board_id",
        "items"
      ],
      "additionalProperties": false
    },
    "estimate_fields": {
      "type": "object",
      "properties": {
        "board_id": {
          "$time_ref": "id"
        }
      },
      "required": [
        "board_id"
      ],
      "additionalProperties": false
    },
    "estimates": {
      "type": "object",
      "properties": {
        "original": {
          "$time_ref": "id"
        },
        "remaining": {
          "$time_ref": "id"
        }
      },
      "required": [
        "original",
        "remaining"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "$time_ref": "id"
        },
        "item": {
          "$time_ref": "id"
        },
        "person": {
          "$time_ref": "id"
        },
        "person_name": {
          "type": "string"
        },
        "work_date": {
          "$time_ref": "date"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "maxLength": 8192
        },
        "sprint": {
          "$time_ref": "id"
        },
        "can_edit": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "item",
        "person",
        "work_date",
        "minutes",
        "version",
        "can_edit"
      ],
      "additionalProperties": false
    },
    "listing": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
