{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "bootstrap-sha": "6eb4b97a1a9df6c0c819b79e12c5ac6c8da2501a",
  "packages": {
    "dashboard": {
      "component": "dashboard",
      "changelog-path": "CHANGELOG.md"
    },
    "research": {
      "component": "research",
      "changelog-path": "CHANGELOG.md"
    },
    "agent-onboarding": {
      "component": "agent-onboarding",
      "changelog-path": "CHANGELOG.md"
    },
    "sso": {
      "component": "sso",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "sso/.wippy",
        "sso/test",
        "sso/test-support",
        "sso/tests",
        "sso/ui/coverage",
        "sso/ui/dist",
        "sso/ui/node_modules"
      ]
    },
    "storage-s3": {
      "component": "storage-s3",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "exclude-paths": [
        "storage-s3/test",
        "storage-s3/ui/dist",
        "storage-s3/ui/node_modules"
      ]
    },
    "docscout": {
      "component": "docscout",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "exclude-paths": [
        "docscout/test",
        "docscout/ui/dist",
        "docscout/ui/node_modules"
      ]
    }
  }
}
