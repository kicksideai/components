{
  "type": "object",
  "description": "Schema declaration using PIMSchemaOptions; named entries replace, omissions stay and remove destroys. Runtime compilation validates meaning.",
  "properties": {
    "dimensions": {
      "type": "array",
      "description": "Context dimensions keyed by name.",
      "items": {
        "type": "object",
        "description": "One dimension and its members.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Dimension name used in attribute scopes and context maps."
          },
          "members": {
            "type": "array",
            "description": "Allowed member names.",
            "items": {
              "type": "string"
            }
          },
          "fallback": {
            "type": "object",
            "description": "Fallback member chains keyed by member.",
            "additionalProperties": {
              "type": "array",
              "description": "Ordered fallback members.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "members"
        ]
      }
    },
    "vocabularies": {
      "type": "array",
      "description": "Term vocabularies keyed by code; edit terms with PIMApply.",
      "items": {
        "type": "object",
        "description": "One vocabulary.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Vocabulary code referenced by select attributes."
          },
          "hierarchical": {
            "type": "boolean",
            "description": "Whether terms may have parents."
          },
          "semantic": {
            "type": "boolean",
            "description": "Whether terms carry semantic identity."
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      }
    },
    "aspects": {
      "type": "array",
      "description": "Attribute groups keyed by namespace; repeated aspects merge their named attributes.",
      "items": {
        "type": "object",
        "description": "One attribute namespace.",
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Aspect namespace; combine with local code as namespace.code."
          },
          "write": {
            "type": "object",
            "description": "Restrict source writes for this aspect.",
            "properties": {
              "sources": {
                "type": "array",
                "description": "Source ids allowed to write this aspect.",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "attributes": {
            "type": "array",
            "description": "Attribute declarations keyed by local code or existing id.",
            "items": {
              "type": "object",
              "description": "Attribute within an aspect; its full coordinate is namespace.code.",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Local attribute code, without the aspect namespace."
                },
                "id": {
                  "type": "integer",
                  "description": "Existing attribute id from PIMSchemaGet; supply it to rename the attribute while retaining its identity."
                },
                "type": {
                  "type": "string",
                  "description": "Installed attribute type id from PIMSchemaOptions; required for a new attribute."
                },
                "scope": {
                  "type": "array",
                  "description": "Ordered dimension names for contextual values; omit for values without dimensions.",
                  "items": {
                    "type": "string"
                  }
                },
                "cardinality": {
                  "type": "string",
                  "description": "one, set or list; omit for one."
                },
                "index": {
                  "type": "string",
                  "description": "Index kind supported by the type from PIMSchemaOptions; omit for none."
                },
                "index_contexts": {
                  "type": "array",
                  "description": "Exact dimension-to-member coordinates to index for contextual attributes.",
                  "items": {
                    "type": "object",
                    "description": "One complete attribute context.",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "unique": {
                  "type": "boolean",
                  "description": "Whether non-null values must be unique across products."
                },
                "vocabulary": {
                  "type": "string",
                  "description": "Vocabulary code used by a select attribute."
                },
                "default": {
                  "description": "Default value in the attribute type; the compiler validates its meaning."
                },
                "config": {
                  "type": "object",
                  "description": "Type-specific configuration validated against the type config_schema from PIMSchemaOptions."
                },
                "width": {
                  "type": "string",
                  "description": "Suggested field width: full, half, third or quarter."
                }
              },
              "additionalProperties": false,
              "required": [
                "code"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "namespace"
        ]
      }
    },
    "families": {
      "type": "array",
      "description": "Product families keyed by code.",
      "items": {
        "type": "object",
        "description": "One family and its variant ownership and readiness rules.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Family code selected by product creation."
          },
          "aspects": {
            "type": "array",
            "description": "Aspect namespaces included in the family.",
            "items": {
              "type": "string"
            }
          },
          "variation": {
            "type": "array",
            "description": "Variant levels in parent-to-child order.",
            "items": {
              "type": "object",
              "description": "One variation level.",
              "properties": {
                "axes": {
                  "type": "array",
                  "description": "Full attribute codes that distinguish variants at this level.",
                  "items": {
                    "type": "string"
                  }
                },
                "own": {
                  "type": "array",
                  "description": "Full attribute codes authored at this level.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "requirements": {
            "type": "array",
            "description": "Readiness sets keyed by id.",
            "items": {
              "type": "object",
              "description": "One readiness set.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Requirement set id referenced by channels and readiness queries."
                },
                "context": {
                  "type": "object",
                  "description": "Dimension-to-member coordinates used to resolve the required attributes.",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "require": {
                  "type": "array",
                  "description": "Full attribute codes that must resolve to values.",
                  "items": {
                    "type": "string"
                  }
                },
                "authored": {
                  "type": "array",
                  "description": "Full attribute codes that must have explicitly authored values.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            }
          },
          "checks": {
            "type": "array",
            "description": "Installed check functions used by this family.",
            "items": {
              "type": "object",
              "description": "One check declaration.",
              "properties": {
                "check": {
                  "type": "string",
                  "description": "Registry check function id."
                },
                "reads": {
                  "type": "array",
                  "description": "Full attribute codes read by the check.",
                  "items": {
                    "type": "string"
                  }
                },
                "cost": {
                  "type": "string",
                  "description": "Check cost, interactive or release; omit for interactive."
                },
                "config": {
                  "type": "object",
                  "description": "Check-specific configuration validated by the check."
                },
                "enforce": {
                  "type": "string",
                  "description": "Enforcement mode, none or write; omit for none."
                }
              },
              "additionalProperties": false,
              "required": [
                "check"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      }
    },
    "sources": {
      "type": "array",
      "description": "External writer sources keyed by id.",
      "items": {
        "type": "object",
        "description": "One source and its write authority.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Source id used by commands."
          },
          "ordering": {
            "type": "string",
            "description": "Ordering discipline, none or sequence; omit for none."
          },
          "writes": {
            "type": "array",
            "description": "Aspect namespaces this source may write.",
            "items": {
              "type": "string"
            }
          },
          "principals": {
            "type": "array",
            "description": "Principal ids allowed to act as this source.",
            "items": {
              "type": "string"
            }
          },
          "audit": {
            "type": "boolean",
            "description": "Whether source changes retain detailed history."
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      }
    },
    "channels": {
      "type": "array",
      "description": "Publication channels keyed by id, such as {id: \"web\"}.",
      "items": {
        "type": "object",
        "description": "One publication channel.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Channel id used by releases and publication feeds; use id, not code."
          },
          "requirements": {
            "type": "array",
            "description": "Readiness set ids required for publication.",
            "items": {
              "type": "string"
            }
          },
          "families": {
            "type": "array",
            "description": "Family codes allowed in this channel.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      }
    },
    "policy": {
      "type": "object",
      "description": "Catalog policy overrides; recognized keys and values are validated at runtime, and false restores the deployment default."
    },
    "scopes": {
      "type": "array",
      "description": "Installed query scope ids from PIMSchemaOptions to adopt.",
      "items": {
        "type": "string"
      }
    },
    "plugins": {
      "type": "array",
      "description": "Plugin choices keyed by use; initial configuration belongs in the request plugin_configs field.",
      "items": {
        "type": "object",
        "description": "One installed plugin choice.",
        "properties": {
          "use": {
            "type": "string",
            "description": "Installed plugin registry id from PIMSchemaOptions.",
            "minLength": 1
          },
          "schema": {
            "type": "object",
            "description": "Catalog-owned schema copy returned by PIMSchemaGet; omit for activation, and never author a replacement copy."
          }
        },
        "additionalProperties": false,
        "required": [
          "use"
        ]
      }
    },
    "remove": {
      "type": "object",
      "description": "Remove only the named entries; omission preserves them.",
      "properties": {
        "dimensions": {
          "type": "array",
          "description": "Dimension names to remove.",
          "items": {
            "type": "string"
          }
        },
        "vocabularies": {
          "type": "array",
          "description": "Vocabulary codes to remove.",
          "items": {
            "type": "string"
          }
        },
        "aspects": {
          "type": "array",
          "description": "Aspect namespaces to remove.",
          "items": {
            "type": "string"
          }
        },
        "families": {
          "type": "array",
          "description": "Family codes to remove.",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "description": "Source ids to remove.",
          "items": {
            "type": "string"
          }
        },
        "channels": {
          "type": "array",
          "description": "Channel ids to remove.",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "array",
          "description": "Full namespace.code attribute coordinates to remove.",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "array",
          "description": "Scope registry ids to remove.",
          "items": {
            "type": "string"
          }
        },
        "plugins": {
          "type": "array",
          "description": "Plugin registry ids to deactivate.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$comment": "SPDX-License-Identifier: LicenseRef-KickSide-Community-1.0"
}
