{
  "name": "@kickside/mail-admin",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "KickSide Mail administration",
  "description": "The mail template library and delivery activity for KickSide Mail.",
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kickside/ui-kit": "^1.7.8",
    "@lezer/highlight": "^1.2.5",
    "@wippy-fe/theme": "0.0.70",
    "@wippy-fe/webcomponent-core": "0.0.70",
    "@wippy-fe/webcomponent-vue": "0.0.70",
    "primevue": "^4.3.0"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "@wippy-fe/proxy": "0.0.70",
    "@wippy-fe/vite-plugin": "0.0.70",
    "happy-dom": "^16.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "0.0.70",
    "vue": "^3.5.0"
  },
  "wippy": {
    "tagName": "kickside-mail-admin",
    "type": "component",
    "description": "Open the mail template library and delivery activity. Library editors review messages, base templates and parts, reset customized resources and restore earlier versions. Delivery administrators review sent and failed messages and send a failed message again.",
    "props": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "default": "",
          "description": "System location relative to this tab, with a library kind, resource name and section, or an activity message ID."
        }
      }
    },
    "scripts": {
      "build": "build"
    }
  },
  "scripts": {
    "build": "vite build --outDir ../static --emptyOutDir",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "private": true,
  "workspaces": [
    "./.wippy/npm/@*/*"
  ]
}
